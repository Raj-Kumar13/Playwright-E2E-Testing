{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-node",
            "request": "launch",
            "name":"Launch",
            "skipFiles": [
                "${/**",
                "<node_internals/**>"
            ],
            "program": "${file}",
            "outFiles": [
                "${workspaceFolder}/**/*.(m|c|)js",
                "!**/node_modules/**",
                "${workspaceFolder}**/*.js"
            ]
        }
    ],
    "compounds": []
}